# Production overrides for docker-compose.yml.
# Copy to .env.docker (gitignored). Loaded AFTER apps/api/.env and
# apps/web/.env, so anything here wins over the localhost dev values.
NEXT_PUBLIC_LEARNHOUSE_API_URL=https://learnhouse.lhscommons.org/api/v1/
NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=https://learnhouse.lhscommons.org/
NEXT_PUBLIC_LEARNHOUSE_PAYLOAD_URL=https://cms.lhscommons.org
NEXT_PUBLIC_LEARNHOUSE_DOMAIN=learnhouse.lhscommons.org
NEXT_PUBLIC_LEARNHOUSE_TOP_DOMAIN=lhscommons.org
NEXT_PUBLIC_LEARNHOUSE_HTTPS=true
# Must match the org slug in the database. The API seeds this slug on a fresh
# install and prefers it when answering /instance/info.
NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=lps
LEARNHOUSE_INITIAL_ORG_SLUG=lps
LEARNHOUSE_DOMAIN=learnhouse.lhscommons.org
LEARNHOUSE_FRONTEND_DOMAIN=learnhouse.lhscommons.org
LEARNHOUSE_SSL=true
NEXTAUTH_URL=https://learnhouse.lhscommons.org
