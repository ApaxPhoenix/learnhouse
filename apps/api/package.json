{
  "name": "@learnhouse/api",
  "version": "1.2.7",
  "private": true,
  "description": "FastAPI backend. Node never runs it; these scripts drive uv so pnpm/turbo can orchestrate it.",
  "scripts": {
    "postinstall": "uv sync",
    "sync": "uv sync",
    "dev": "uv run uvicorn app:app --reload --host 0.0.0.0 --port 9000",
    "start": "uv run uvicorn app:app --host 0.0.0.0 --port 9000 --timeout-keep-alive 600",
    "test": "uv run pytest"
  }
}
